# Gadai — copy to .env (never commit). Every var the code reads is listed here.
# REQUIRED vars make the process throw "Missing env X (see .env.example)" when unset. Nothing is mocked.

# ───────── core ─────────
BASE_RPC_URL=https://base-rpc.publicnode.com       # any Base mainnet RPC
DEMO_FORK=0                                         # 1 = every on-chain action goes to the Anvil fork (clearly labeled in UI). Flash is disabled in this mode.
FORK_RPC_URL=http://127.0.0.1:8545                  # `pnpm fork` (anvil --fork-url $BASE_RPC_URL --chain-id 8453)
AGENT_PORT=8787
AGENT_PUBLIC_URL=                                   # REQUIRED. Public https URL of the agent (cloudflared/ngrok tunnel or deploy). Used by the Bankr Skill, Flynet OAuth redirect, Dynamic webhook.
WEB_URL=http://localhost:3000                       # web app origin (CORS + OAuth return)
EXTRA_WEB_ORIGINS=                                   # optional, comma-separated extra CORS origins (e.g. the Vercel deploy)
DB_PATH=./feedesk.db                                # node:sqlite file
ADMIN_TOKEN=                                        # REQUIRED for /api/admin/* (manual keeper run in demo). Any long random string.
ERC8004_DESK_AGENT_ID=                              # optional: the desk's ERC-8004 agentId (Base IdentityRegistry 0x8004A169…a432), owned by AGENT_WALLET_ADDRESS.
                                                    #   Empty = the agent registers one on start and stores it in the DB (a fresh fork re-registers).
RISK_CHECK=on                                       # on|off. On: before approving, the Dynamic agent wallet buys a honeypot-check verdict over x402
                                                    #   ($0.05 real USDC on Base MAINNET, even in DEMO_FORK). Skipped with a note when the wallet holds < $0.05.
RISK_MAX_USDC_PER_DAY=1                             # daily x402 spend cap for risk verdicts (USDC)
RISK_AUTO_TOPUP=0                                   # 1: when the wallet holds < the x402 price, swap the minimum ETH -> USDC on Base mainnet
                                                    #   (EXACT_OUTPUT max(price x 1.2, $0.10), Uniswap Trading API, Universal Router) before paying. Never on DEMO_FORK.
RISK_TOPUP_MAX_USDC_PER_DAY=0.5                     # daily cap on USDC bought by the auto top-up
RISK_TOPUP_MAX_ETH=0.0001                           # max ETH one top-up swap may spend (tx value)
FEEDESK_MODULES=                                    # optional subset, e.g. db,bankr,underwriter,server while other modules are being built

# ───────── contracts (contracts/ Foundry) ─────────
FEE_DESK_ADDRESS=                                   # REQUIRED (mainnet). Output of `pnpm contracts:deploy`.
FORK_FEE_DESK_ADDRESS=                              # REQUIRED when DEMO_FORK=1. Deploy the same script against FORK_RPC_URL.
DEPLOYER_PRIVATE_KEY=                               # only for forge script deploy (pays gas once). FeeDesk.keeper is set to AGENT_WALLET_ADDRESS.
AGENT_WALLET_ADDRESS=                               # the Dynamic agent wallet address (printed by `pnpm --filter @feedesk/agent bootstrap:dynamic`)
ORACLE_MAX_AGE_SEC=                                 # optional Chainlink staleness bound baked into FeeDesk at deploy: 3600 default; deploy:fork uses 86400 (fork clock drifts)
DESK_TREASURY=                                      # receives dining-draw repayments (FeeVault.payDesk). Default: the DEPLOYER address. Must NOT equal AGENT_WALLET_ADDRESS (deploy refuses).

# ───────── underwriting / keeper knobs (defaults in SPEC §4) ─────────
DESK_MAX_LOAN_USDC=250                              # hard cap per loan, whole USDC
KEEPER_INTERVAL_SEC=300
MIN_SWAP_WETH=0.002                                 # don't swap dust
AUCTION_BLOCKS=150                                  # CCA length (Base ≈2s/block ⇒ 5 min). Demo-friendly; raise for real loans. FeeVault.startAuction caps it at 43200.
AUCTION_CLAIM_DELAY_BLOCKS=0                        # ≤ 1800 (FeeVault.startAuction bound)
DESK_ANCHOR_BID_PCT=101                             # % of principal the desk's own Dynamic wallet bids in each FeeNote CCA at the lead persona's price (0 = lenders only; keep ≥101: exactly 100 misses graduation by CCA rounding)
CCA_WATCH_SEC=15                                    # FeeNote auction watcher period: anchor-bid retry, checkpoint+disburse/cancel, desk exit/claim/redeem

# ───────── Bankr (https://bankr.bot/api-keys) ─────────
BANKR_LLM_KEY=                                      # REQUIRED. bk_... with "LLM Gateway" enabled AND credits > $0 (bankr llm credits add 10). 401/402 otherwise.
BANKR_API_KEY=                                      # optional fallback for BANKR_LLM_KEY; also used only if the desk submits via Bankr Wallet API
BANKR_LLM_MODEL=claude-sonnet-4.6                   # lead persona model; others set in underwriter/personas
UNDERWRITER_ENGINE_ONLY=0                           # 1 = when the LLM Gateway answers 402/insufficient_credits (ONLY then; 401 bad key always fails), personas fall back to
                                                    #     their deterministic rule sets (engine.ts ruleMemo), memos labeled model "rules (Bankr LLM unavailable)";
                                                    #     such loans publish signals but queue NO follower mirror orders. 0 = no credits → apply fails (502).
BANKR_API_BASE=https://api.bankr.bot

# ───────── Dynamic (https://console.dynamic.xyz → Developer → API; enable embedded wallets, external-wallet auth, Base 8453) ─────────
DYNAMIC_ENVIRONMENT_ID=                             # REQUIRED (agent)
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=                 # REQUIRED (web) — same value
DYNAMIC_APP_ORIGIN=http://localhost:3000            # must be on the environment CORS allowlist; header-based JWT (not cookie) auth
AGENT_SIGNING_TOKEN=                                # REQUIRED. 0x 32-byte key = the agent's Dynamic identity. Generate once via bootstrap:dynamic; NEVER rotate (new identity = lost wallet)
DYNAMIC_SESSION_KEY_JWK=                            # REQUIRED. single-line JSON from bootstrap:dynamic
DYNAMIC_SESSION_PUBLIC_KEY_HEX=                     # REQUIRED. from bootstrap:dynamic
DYNAMIC_WALLET_PASSWORD=                            # REQUIRED. choose once; needed to decrypt the Dynamic backup
DYNAMIC_AGENT_WALLET_METADATA=                      # REQUIRED after first run. single-line JSON printed on first createWalletAccount
DYNAMIC_AGENT_KEY_SHARES=                           # REQUIRED after first run. single-line JSON (SECRET)
DYNAMIC_AUTH_TOKEN=                                 # only for delegated access (Follow-the-Desk auto mirror): Console API token dyn_...
DYNAMIC_WEBHOOK_SECRET=                             # only for delegated access: Console → Webhooks, endpoint $AGENT_PUBLIC_URL/api/dynamic/webhook
DYNAMIC_DELEGATION_PRIVATE_KEY=                     # only for delegated access: RSA PEM (openssl genrsa 3072), \n-escaped; upload public key in Console

# ───────── Uniswap (https://developers.uniswap.org/dashboard) ─────────
UNISWAP_API_KEY=                                    # REQUIRED. Trading API key (x-api-key). Used for ETH/USD pricing + keeper WETH→USDC.
UNISWAP_UR_VERSION=2.0                              # sent as x-universal-router-version on every call
UNISWAP_MAX_PRICE_IMPACT_PCT=1                      # keeper swap guard (percent); the vault also enforces >= 95% of the Chainlink price

# ───────── Definitive Flash (app.definitive.fi → More → Flash → Create Flash Key) ─────────
FLASH_API_KEY=                                      # REQUIRED. Own key (public dev key dpka_513a2bd7_... works but attributes orders to Definitive)
FLASH_BASE_URL=https://flash.definitive.fi/v1
FLASH_INTEGRATOR_FEE_BPS=                           # optional, same value on quote+order
FLASH_TOKEN_LEG_MODE=vault1271                      # vault1271 = FeeVault is the Flash funder (EIP-1271); keeper = send leg to agent wallet, TWAP, repay.
AUTO_MIRROR_ON_FORK=0                                # DEMO_FORK safety: auto mirrors settle on Base mainnet, so the executor is off on a fork unless this is 1
                                                    #   Fixed per vault at createLoan (CreateLoanParams.keeperTokenCustody = mode is keeper); switching later only affects new loans.
BASE_BUILDER_CODE=                                  # optional Base Builder Code (bc_...): ERC-8021 suffix on every desk tx (agent wallet) + Flash erc8021AttributionCode on /order

# ───────── Blackbird Flynet (https://make.flynet.org, staging keys are instant) ─────────
FLYNET_ENV=staging
FLYNET_API_KEY=                                     # REQUIRED for /api/flynet/*. fly_test_... scopes: read:app read:balance write:rewards read:checkins read:restaurant_specials read:restaurant_challenges
FLYNET_CLIENT_ID=                                   # REQUIRED for member OAuth
FLYNET_CLIENT_SECRET=                               # REQUIRED for member OAuth
FLYNET_REDIRECT_URI=                                # REQUIRED. exactly $AGENT_PUBLIC_URL/api/flynet/callback (registered in Make dashboard; no localhost)
FLYNET_AUDIENCE=                                    # REQUIRED by FlynetOAuth; value from Make dashboard / support@blackbird.xyz (undocumented)
FLYNET_MERCHANT_ID=                                 # optional; GET /app returns it
FLYNET_MAX_PAY_FLY=5                                # cap on ONE FLY charge via POST /api/loans/:id/dine/pay (FLY, not wei). Keep it small.

# ───────── web (Next.js, browser-visible) ─────────
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
NEXT_PUBLIC_DEMO_FORK=0                             # 1 = show DEMO_FORK banner, browser reads the fork (see next line)
NEXT_PUBLIC_FORK_RPC_URL=agent                       # agent (or empty) = $NEXT_PUBLIC_AGENT_URL/api/rpc, the agent's read-only RPC proxy (no Anvil exposed).
                                                    #   Or a direct fork URL, e.g. http://127.0.0.1:8545. anvil_mine / impersonation always use Anvil directly.

# ───────── DEMO_FORK / tests only (never needed on mainnet) ─────────
DEMO_BORROWER_KEY=                                  # fork-borrower.ts signer standing in for the 7702 test-pool beneficiary. Default: Anvil dev key #0
FORK_E2E_RPC=                                       # keeper.fork.test.ts: a FRESH anvil fork (e.g. http://127.0.0.1:8546); test skips when unset
FORK_BLOCK=51480600                                 # pnpm contracts:test pins the fork here (RPC must serve that block)
